{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 800,
        "minHeight": 680,
        "minWidth": 1000,
        "title": "SK Plugin Manager",
        "width": 1200
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "dmg",
      "nsis"
    ]
  },
  "identifier": "com.skmotion.pluginmanager",
  "productName": "SK Plugin Manager",
  "version": "1.0.0"
}
